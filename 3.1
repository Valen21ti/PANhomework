#include <iostream>
#include <vector>
#include <iomanip>

int main() {
    double v0 = 50.0; 
    double g = 9.8;     
    double dt = 1.0;  

    if (v0 <= 0) {
        std::cout << "начальная скорость меньше нуля" << std::endl;
        return 0;   }
    std::vector<double> times;
    std::vector<double> heights;

    times.reserve((int)(v0 * 2 / g / dt));
    heights.reserve((int)(v0 * 2 / g / dt));
    for (double t = 0.0; t <= 1000; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;

        if (h < 0) {
            break;   }
        times.push_back(t);
        heights.push_back(h);  }

    std::cout << std::setw(10) << "t,с" << std::setw(15) << "h,м" << std::endl;

    for (int i = 0; i < times.size(); i++) {
        std::cout << std::setw(10) << std::fixed << std::setprecision(2) << times[i]
                  << std::setw(15) << std::fixed << std::setprecision(2) << heights[i]
                  << std::endl;
    }

    return 0;
}
