#include <iostream>
using namespace std;
struct airplane {
    string name; 
    double m;    
    double S;    
    double T;    
    double CD;   
    double CL;   
};
int main() {
    double r = 1.2; 
    double V = 100.0; 
    airplane planes[3] = {
        {"Самолет А", 1000, 20, 5000, 0.03, 0.5},
        {"Самолет Б", 1500, 25, 8000, 0.04, 0.6},
        {"Самолет В", 800,  15, 3000, 0.02, 0.4}
    };
    double max = -100.0;
    string best = "";    
    cout << "Скорость V = " << V << ", Плотность r = " << r << endl << endl;
    for (int i = 0; i < 3; i++) {
        double L = 0.5 * r * (V * V) * planes[i].S * planes[i].CL;
        double D = 0.5 * r * (V * V) * planes[i].S * planes[i].CD;
        double a = (planes[i].T - D) / planes[i].m;

        cout << "Самолет: " << planes[i].name << endl;
        cout << "  Подъемная сила L: " << L << " Н" << endl;
        cout << "  Сопротивление D:  " << D << " Н" << endl;
        cout << "  Ускорение a:      " << a << " м/с^2" <<endl << endl;

        if (a > max) {
            max = a;
            best = planes[i].name;
        } }
    cout <<  best ;
    cout <<    max << " м/с^2" << endl;

    return 0;
}
