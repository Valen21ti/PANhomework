#include <iostream>
#include <vector>
#include <iomanip>
#include <algorithm>   
#include <iterator>  

int main() {
    double v0 = 50.0;
    double g = 9.8;
    double dt = 1.0
;
    std::vector<double> times;
    std::vector<double> heights;
    for (double t = 0.0; t <= 20; t += dt) {
        
double h = v0 * t - 0.5 * g * t *
 t;
        times.push_back(t);
        heights.push_back(h);    }
    if (heights.empty()) {
        std::cout << "данных нет" << std::endl;
        return 0;  }
    auto it = std::find_if(heights.begin() + 1, heights.end(),
                           [](double h) { return h <= 0.0; });

    if (it == heights.end()) {
        std::cout << "падения не былое" << std::endl;
    } else {
        size_t idx = std::distance(heights.begin(), it);
        double t_fall = times[idx];

       std::cout << std::fixed << std::setprecision(2);
        std::cout << t_fall << " с " << heights[idx] << " м\n";
}

    return 0;
}

